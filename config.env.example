# MediaCompressorWebApp Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Flask secret key for session management (change for any non-local deployment)
SECRET_KEY=change-me-to-a-random-string

# SQLite database file path
DB_PATH=file_db.db

# Worker counts (used directly if AUTO_SCALE is false)
WORKER_COUNT_IMAGES=4
WORKER_COUNT_VIDEOS=2

# When true, worker pool sizes are auto-scaled from detected CPU and RAM
AUTO_SCALE=true

# NOTE: HW_ACCEL_MODE is defined in Config but currently not evaluated in encoder selection.
# Hardware acceleration selection is governed by codec choice and startup probing.
HW_ACCEL_MODE=auto

# Retries before a file permanently fails
MAX_RETRIES=3

# Processing timeout in minutes (watchdog reaps stuck files)
PROCESSING_TIMEOUT_MINUTES=30

# Minimum free disk space (in MB) required on output drive before dispatching
MIN_FREE_DISK_MB=100

# Logging configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_JSON=false

# Server binding
# CAUTION: Application does not enforce authentication. Binding to 0.0.0.0 exposes
# file creation, execution, and history flushing to your local network.
HOST=127.0.0.1
PORT=5000
